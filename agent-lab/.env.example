# Copy this file to .env and fill in your key.
# .env is git-ignored. Never commit a real key to this repository.
#
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)

# Required for any lab that makes a real API call.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Overrides the default model used by common/client.py.
# LAB_MODEL=claude-opus-5
